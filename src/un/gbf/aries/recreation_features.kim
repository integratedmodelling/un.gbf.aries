private namespace un.gbf.aries.recreation_features;

/*
 * Mountain detection can be better but works OK for now. Contextualizer will automatically adjust
 * radius for small contexts. Threshold logic for low mountains/hills can be improved (may benefit 
 * from dynamic radius in that case, as hills are typically less 'pointy' than mountains).
 */
model each earth:MountainPeak
	observing geography:Elevation > 0 in m named elevation
	using im.geomorphology.findmaxima(surface = elevation, threshold = [max * 0.65], radius = 8000);


/*ROS EU */
//esa_people:ros2_new_2018_uint8 in aux 


 
@color(red)
model each behavior.incubation:ViewPoint
	using gis.osm.query(
		feature-type="point", 
		equal=("tourism", "viewpoint"));

		
@color(blue)
model each behavior.incubation:Campsite
	using gis.osm.query(
		feature-type="point", 
		equal=("tourism", "camp_site")); 

//number xx observing count of Campsite per km^2;

observe earth:Region named test_global_country_boundaries
	over space(urn='local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un#GID=RUS',	
//	'local:srwohl:im.data.global:im-data-global-geography_global_countries#iso3=RUS',
//	'local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un'
//	'local:ferdinando.villa:im.data.global:admin.countries.un#gid=ita',
		   grid="300 m"),
		time(start=2020, end=2021, step=1.year);
