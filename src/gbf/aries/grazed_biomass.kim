///* MODELLING DRY MATTER PRODUCTIVITY (SUPPLY) */
//
//model ecology:LightUseEfficiency named light_use_efficiency
//	observing
//		type of ecology:Grassland named vegetation_cover,
//		landcover:LandCoverType named lc
//	lookup (vegetation_cover, lc, ?) into ADJUSTED_GPP_TABLE; 
//
//model ecology:Vegetation ecology:PrimaryProductivity in t/ha
//	observing
//		im:Gross chemistry:Carbon ecology:PrimaryProductivity in g/m^2 named gross_primary_productivity,
//		ecology:LightUseEfficiency named light_use_efficiency
//	set to [gross_primary_productivity * light_use_efficiency * 2.7 * 0.01 * 0.5]; // converted gC/m2 > tDM/ha
//
//// WE DON'T NEED THE TYPE OF, JUST PRESENCE OF
////model type of ecology:HerbaceousVegetationLanduse 
////	observing
////		type of ecology:Grassland named grassland_type, 
////		landcover:LandCoverType named landcover 
////  	lookup (grassland_type, landcover,*, *, ? )
////  	into	VEGETATION_SUITABLE_FOR_PASTURE;
//
//model presence of im:Potential ecology:Vegetation earth:Region for im:Natural agriculture:Pasture 
//	named presence_natural_pastureland
//	observing
//		type of ecology:Grassland named grassland_type, 
//		landcover:LandCoverType named landcover 
//  	lookup (grassland_type, landcover, ? ,im:Natural) 
//  	into VEGETATION_SUITABLE_FOR_PASTURE;
//
//model im:Potential im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity in t/ha named potential_natural_vegetation_supply_for_grazing
//	observing
//		presence of im:Potential ecology:Vegetation earth:Region for im:Natural agriculture:Pasture named presence_natural_pastureland,
//		ecology:Vegetation ecology:PrimaryProductivity in t/ha named productivity
//	set to [(presence_natural_pastureland) ? productivity : unknown];

/* STEP 1 grazing supply */
// Natural grazing supply pre-computed and aggregated to 1km 

model 'local:liberentaizp:im.data.global:im-data-global-ecology.global_gbfb1_grazed_biomass_supply_epsg4326_1km_2020_v3',
	  'local:liberentaizp:im.data.global:im-data-global-ecology.global_gbfb1_grazed_biomass_supply_epsg4326_1km_2022_v1'
	  as im:Potential im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity in t/ha named potential_natural_vegetation_supply_for_grazing;
	  

/* MODELLING DRY MATTER DEMAND */
// Livestock grazing distribution (GPW) number of heads of livestock per 1km grid cell (FAO stat adjusted) 
@extensive(space)
model 	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2000_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2001_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2002_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2003_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2004_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2005_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2006_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2007_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2008_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2009_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2010_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2011_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2012_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2013_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2014_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2015_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2016_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2017_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2018_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2019_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2020_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2021_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_cattle_headcount_epsg4326_1km_2022_v1'
	as count of biology:Individual agriculture:Cattle;

@extensive(space)
model count of biology:Individual agriculture:DairyCattle
	observing
	type of geography:ContinentalRegion named region,
	count of biology:Individual agriculture:Cattle named cattle_count
	lookup(region, ?, *) into CATTLE_DISTRIBUTION_TABLE
	set to [ cattle_count * self ];

@extensive(space)
model count of biology:Individual agriculture:BeefCattle
	observing
	type of geography:ContinentalRegion named region,
	count of biology:Individual agriculture:Cattle named cattle_count
	lookup(region, *, ?) into CATTLE_DISTRIBUTION_TABLE
	set to [ cattle_count * self ];

