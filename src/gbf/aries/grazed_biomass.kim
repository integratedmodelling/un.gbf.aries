	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2010_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2011_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2012_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2013_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2014_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2015_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2016_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2017_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2018_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2019_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2020_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2021_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_goat_headcount_epsg4326_1km_2022_v1'
 	as count of biology:Individual agriculture:Goat;
 	
@extensive(space)
model 	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2000_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2001_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2002_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2003_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2004_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2005_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2006_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2007_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2008_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2009_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2010_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2011_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2012_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2013_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2014_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2015_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2016_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2017_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2018_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2019_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2020_v1',
		'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2021_v1',
	  	'local:rubencc:im.data.global:im-data-global-agriculture.global_gpw_faostat_horse_headcount_epsg4326_1km_2022_v1' /// horses not available?
 	as count of biology:Individual agriculture:Horse;

@extensive(space)
model im:Mean agriculture:BeefCattle im:Weight in kg
	observing
		type of geography:ContinentalRegion named region
	lookup (agriculture:BeefCattle, region, ?) into IPCC_LIVESTOCK_WEIGHT;

@extensive(space)
model im:Mean agriculture:DairyCattle im:Weight in kg
	observing
		type of geography:ContinentalRegion named region
	lookup (agriculture:DairyCattle, region, ?) into IPCC_LIVESTOCK_WEIGHT;

// model annual cattle intake needs 
/// MC: we want to switch the use of nutrient to 'intake' the concept defined locally above
@extensive(space)
model im:Yearly agriculture:DairyCattle biology.incubation:Intake in t
	observing
		im:Mean agriculture:DairyCattle im:Weight in kg 	named average_dairy_cattle_weight,
		count of biology:Individual agriculture:DairyCattle named diary_cattle_units
	set to [ average_dairy_cattle_weight * diary_cattle_units * 0.025 * 365 * 0.001];

@extensive(space)
model im:Yearly agriculture:BeefCattle biology.incubation:Intake in t
	observing
		im:Mean agriculture:BeefCattle im:Weight in kg named average_beef_cattle_weight,
		count of biology:Individual agriculture:BeefCattle named beef_cattle_units
	set to [ average_beef_cattle_weight * beef_cattle_units * 0.025 * 365 * 0.001];
	
// Sheep 
model im:Mean agriculture:Sheep im:Weight in kg
	observing
		type of geography:ContinentalRegion named region
	lookup (agriculture:Sheep, region,?) into IPCC_LIVESTOCK_WEIGHT;

//model annual sheep dry matter biology:Biomass in t needs 
model im:Yearly agriculture:Sheep biology.incubation:Intake in t
	observing
		im:Mean agriculture:Sheep im:Weight in kg named average_sheep_weight,
		count of biology:Individual agriculture:Sheep named sheep_units
	set to [ average_sheep_weight * sheep_units *0.025*365*0.001];

// Goats 
model im:Mean agriculture:Goat im:Weight in kg
observing
	type of geography:ContinentalRegion named region
	lookup (agriculture:Goat,region,?) into IPCC_LIVESTOCK_WEIGHT;

@extensive(space) 
model im:Yearly agriculture:Goat biology.incubation:Intake in t
observing
	im:Mean agriculture:Goat im:Weight in kg named average_goat_weight,
	count of biology:Individual agriculture:Goat named goat_units
	set to [ average_goat_weight * goat_units *0.025*365*0.001];
	
// Horses 
model im:Mean agriculture:Horse im:Weight in kg
observing
	type of geography:ContinentalRegion named region
	lookup (agriculture:Horse,region,?) into IPCC_LIVESTOCK_WEIGHT;

@extensive(space)
model im:Yearly agriculture:Horse biology.incubation:Intake in t
observing
	im:Mean agriculture:Horse im:Weight in kg named average_horse_weight,
	count of biology:Individual agriculture:Horse named horse_units
	set to [ average_horse_weight * horse_units *0.025*365*0.001];

@extensive(space)
model im:Yearly agriculture:Livestock biology.incubation:Intake in t named total_livestock_demand
observing 
	im:Yearly agriculture:DairyCattle biology.incubation:Intake in t named yearly_dairy_cattle_nutrient_intake,
	im:Yearly agriculture:BeefCattle biology.incubation:Intake in t named yearly_beef_cattle_nutrient_intake,
	im:Yearly agriculture:Goat biology.incubation:Intake in t named yearly_goat_nutrient_intake,
	im:Yearly agriculture:Sheep biology.incubation:Intake in t named yearly_sheep_nutrient_intake,
	im:Yearly agriculture:Horse biology.incubation:Intake in t named yearly_horse_nutrient_intake
	set to [yearly_dairy_cattle_nutrient_intake + yearly_beef_cattle_nutrient_intake + yearly_goat_nutrient_intake + yearly_sheep_nutrient_intake + yearly_horse_nutrient_intake];

/* MODELLING GRAZED BIOMASS USE */
@documented(gbf.grazing.biomass.global)
model ses:UseFlow im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity in t/ha named estimated_use_of_natural_grazed_biomass
observing
	im:Potential im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity in t/ha named natural_vegetation_biomass_supply_for_grazing,
	im:Yearly agriculture:Livestock biology.incubation:Intake in t named total_livestock_demand
	set to [ (natural_vegetation_biomass_supply_for_grazing == unknown || total_livestock_demand == unknown) 
			? 0 :
			(natural_vegetation_biomass_supply_for_grazing > total_livestock_demand)
			? total_livestock_demand : natural_vegetation_biomass_supply_for_grazing];

