project private namespace gbf.aries.coastal.protection.summary_tables
	using 	gbf.aries.coastal.protection.hazard,
			gbf.aries.coastal.protection.exposurevulnerability;

define table cp_demand_endangered_people_table as {
	name: "cp_demand_endangered_people_table"
	title: "Coastal Protection Demand (people in hazardous areas)",
	label: "Coastal Protection Demand (number of people)",
	target: es.coastalprotection:GlobalVulnerabilityMetric
	columns:({ 	title:  "{classifier}",
				target: count of (demography:HumanIndividual with risk:Exposure),
				filter: risk.incubation:ProtectiveHabitatType

			}
			{	title: "Sum", 
				summarize: sum, style: bold
			}
			{	title: "Total (not sum)", 
//				summarize: sum, style: bold
				target: count of (demography:HumanIndividual with risk:Exposure)
			}
			)
	rows:   ({	title: "{classifier}",  
				filter: es.coastalprotection:GlobalVulnerabilityMetric
			}
			{title: "Total", summarize: sum, style: bold}
			)
	};
	
define table cp_supply_protected_people_table as {
	name: "cp_supply_protected_people_table"
	title: "Coastal Protection Supply (people in hazardous areas beneffited from the presence of an ET)",
	label: "Coastal Protection Supply (number of people)",
	target: es.coastalprotection:GlobalVulnerabilityMetric
	columns:({ 	title:  "{classifier}",
				target: es.coastalprotection:CoastalProtectionBeneficiary demography:HumanIndividual ,
				filter: risk.incubation:ProtectiveHabitatType

			}
			{	title: "Sum", 
				summarize: sum, style: bold
			}
			{	title: "Total (not sum)", 
//				summarize: sum, style: bold
				target: es.coastalprotection:CoastalProtectionBeneficiary demography:HumanIndividual
			}
			)
	rows:   ({	title: "{classifier}",  
				filter: es.coastalprotection:GlobalVulnerabilityMetric
			}
			{title: "Total", summarize: sum, style: bold}
			)
	};
define table cp_supply_hazard_reduction_table as {
	name: "cp_deltahazard_supply_table"
	title: "Coastal Protection Supply (decrease in hazard by protective ET)",
	label: "Coastal Protection Supply (delta hazard)",
	target: es.coastalprotection:GlobalVulnerabilityMetric
	columns:({ 	title:  "All",
				target: aries.global.coastalprotection.exposurevulnerability.stratified.delta_all
			}
			)
	rows:   ({	title: "{classifier}",  
				filter: es.coastalprotection:GlobalVulnerabilityMetric
			}
			{title: "Total", summarize: sum, style: bold}
			)
	};
	
define table cp_supply_cpi_table as {
	name: "cp_new_headcount_supply_table"
	title: "Coastal Protection Supply (people in hazardous areas beneffited from the presence of an ET)",
	label: "Coastal Protection Supply (number of people)",
	target: es.coastalprotection:GlobalVulnerabilityMetric
	columns:({ 	title:  "Mangrove",
				target: es.coastalprotection:CoastalProtectionIndex of (earth:Coast with risk.incubation:Mangrove) 
			}
			{ 	title:  "Saltmarsh",
				target: es.coastalprotection:CoastalProtectionIndex of (earth:Coast with risk.incubation:SaltMarsh) 
			}
			{ 	title:  "Coral reef",
				target: es.coastalprotection:CoastalProtectionIndex of (earth:Coast with risk.incubation:CoralReef)
			}
			{ 	title:  "Seagrass",
				target: es.coastalprotection:CoastalProtectionIndex of (earth:Coast with risk.incubation:SeaGrass)
			}
			{	title: "Total (mean hazard)", 
				target: im:Mean es.coastalprotection:CoastalProtectionIndex
			}
			{	title: "Total (max hazard)", 
				target: im:Maximum es.coastalprotection:CoastalProtectionIndex
			}
			{	title: "Total (summed hazard)", 
				target: risk.incubation:Aggregated es.coastalprotection:CoastalProtectionIndex
			}
			)
	rows:   ({	title: "{classifier}",  
				filter: es.coastalprotection:GlobalVulnerabilityMetric
			}
			{title: "Total", summarize: sum, style: bold}
			)
	};
	
	
