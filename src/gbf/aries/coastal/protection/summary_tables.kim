				title: "Closing CPI Unknown Vulnerability ({time})",  
				filter: (es.coastalprotection:GlobalVulnerabilityMetric, end),
				keep: es.coastalprotection:UnknownVulnerability
			}
			empty
			
			// --- NET CHANGE (Closing - Opening) ---
			{	title: "Net Change Low Vulnerability", 
				summarize: [close_low - open_low], 
				style: bold
			}
			{	title: "Net Change Medium Vulnerability", 
				summarize: [close_med - open_med], 
				style: bold
			}
			{	title: "Net Change High Vulnerability", 
				summarize: [close_high - open_high], 
				style: bold
			}
			{	title: "Net Change Unknown Vulnerability", 
				summarize: [close_unknown - open_unknown], 
				style: bold
			}
			)
	};
*/
	
