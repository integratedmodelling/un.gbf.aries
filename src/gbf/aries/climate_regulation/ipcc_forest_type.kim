private namespace gbf.aries.climate_regulation.ipcc_forest_type
	using 
		nca.landuse.ipcc, 
		nca.ecology.ipcc,
		aries.global.carbon.forest_type.ipcc;

quantity Integrity;
quantity Year;


observe earth:Region named test_semantic_primary_forest_north_colombia_forest
	over space(shape='EPSG:4326 POLYGON ((-72.81428012081768 9.319326461106442, -72.82096193020851 9.252373938939925, -72.84075058019336 9.187982341549372, -72.87288560405088 9.12862833708337, -72.91613207083574 9.07659598842821, -72.96882804308235 9.033888501069669, -73.02894844412948 9.0021506956828, -73.09418288068079 8.982605265279943, -73.16202442992352 8.976005342944887, -73.22986597916626 8.982605265279943, -73.29510041571758 9.0021506956828, -73.3552208167647 9.033888501069669, -73.40791678901131 9.07659598842821, -73.45116325579619 9.12862833708337, -73.48329827965371 9.187982341549372, -73.50308692963854 9.252373938939925, -73.50976873902937 9.319326461106442, -73.50308692963854 9.386266146864273, -73.48329827965371 9.45062118933511, -73.45116325579619 9.509920485717672, -73.40791678901131 9.561888302127599, -73.3552208167647 9.604531257607988, -73.29510041571758 9.63621435579769, -73.22986597916626 9.65572323216712, -73.16202442992352 9.66231031846057, -73.09418288068079 9.65572323216712, -73.02894844412948 9.63621435579769, -72.96882804308235 9.604531257607988, -72.91613207083574 9.561888302127599, -72.87288560405088 9.509920485717672, -72.84075058019336 9.45062118933511, -72.82096193020851 9.386266146864273, -72.81428012081768 9.319326461106442))',
		   grid="300 m"),
		time(start=2020, end=2022, step=1.year);
		
observe earth:Region named test_semantic_plantation_model
	over space(shape='EPSG:4326 POLYGON ((-76.72439575195312 7.985911007561455, -76.58203122206031 7.986817641519593, -76.58203122206031 7.855786263722578, -76.72210692660883 7.850798103288284, -76.72439575195312 7.985911007561455))',
		   grid="30 m"),
		time(start=2020, end=2022, step=1.year);
		

/*
 * # 1) Primary Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
/* MODELLING - PRIMARY FORESTS  */
model 'local:rubencc:im.data.global:im-data-global-conservation.global_nasa_forest_height_30m_2000'
	as im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000;
	
model 'local:rubencc:im.data.global:im-data-global-conservation.global_nasa_forest_height_30m_2020'
	as im:Height of ecology:Forest earth:Region in m named forest_height_2020;

model local:rubencc:im.data.global:im-data-global-conservation.global_intact_forest_landscapes_2000
	as presence of im:Reference conservation:Intact ecology:Forest earth:Region named intact_forest_presence_2000
	set to [self == 1 ? true : false];

model 'local:megan.critchley:im.data.global:im-data-global-ecology.global_forest_landscape_integrity_index_epsg4326_300m_2019'
	as Integrity of ecology:Forest earth:Region named forest_integrity
	set to [self * 0.001];
		 
model local:rubencc:im.data.global:im-data-global-conservation.global_tropical_moist_forest_transition_subtyp_30m_v1_1982_2024	 
	as type of ecology:Tropical ecology:Forest named tropical_forest_type
	classified into
		ecology:Tropical nca.landuse.ipcc:PrimaryForest if 10,
		ecology:Tropical nca.landuse.ipcc:OldSecondaryForest if 31,
 		ecology:Tropical nca.landuse.ipcc:YoungSecondaryForest if in (32, 33, 92, 93, 94),		
 		ecology:Tropical nca.landuse.ipcc:OldPlantedForest if 81,
 		ecology:Tropical nca.landuse.ipcc:YoungPlantedForest if in (82, 83, 84, 85, 86);
 	  	
model local:alessio.bulckaen:im.data.global:im-data-global-ecology.global_primary_humid_tropical_forests_epsg4326_30m_2001
	as presence of ecology:Tropical nca.landuse.ipcc:PrimaryForest earth:Region named tropical_humid_primary_forest_presence
	set to [self == 1 ? true : false]; 	// binary result: 1 or 0
	
model local:rubencc:im.data.global:im-data-global-ecology.europe_primary_forests_100m_4326_2018
	as presence of nca.landuse.ipcc:PrimaryForest geography:European earth:Region named europe_primary_forest_presence;

//// FOREST LOSS and GAIN (HANSEN GFC DATASET)
model local:alessio.bulckaen:im.data.global:im-data-global-conservation.global_forest_watch_data_lossyear_2000_2022 
	as Year of im:Removed ecology:Forest earth:Region named year_of_deforestation
	set to [self + 2000];
 
model presence of im:Likely nca.landuse.ipcc:PrimaryForest earth:Region named estimated_primary_forest_presence
	observing			
		Integrity of ecology:Forest earth:Region named forest_integrity,
		presence of im:Reference conservation:Intact ecology:Forest earth:Region named intact_forest_presence_2000,
		type of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of ecology:Tropical nca.landuse.ipcc:PrimaryForest earth:Region named tropical_humid_primary_forest_presence,
		presence of nca.landuse.ipcc:PrimaryForest geography:European earth:Region named europe_primary_forest_presence,
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		Year of im:Removed ecology:Forest earth:Region named year_of_deforestation			
	set to [
		(((forest_integrity >= 9.8) || intact_forest_presence_2000 || (tropical_forest_type is ecology:Tropical nca.landuse.ipcc:PrimaryForest) || tropical_humid_primary_forest_presence || europe_primary_forest_presence) 
			&& ((forest_height_2000 >= 5) && (forest_height_2020 >= 5)) 
			&& (year_of_deforestation > 2020)
		) ? true : false
	];

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 2) Old Plantation Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
model 'local:alessio.bulckaen:im.data.global:im-data-global-conservation.global_treeplantationyears_forestry_epsg4326_30m_2020_mosaic'
	as Year of agriculture:Planted ecology:Forest earth:Region named plantation_year
	set to [((self != 32767) && (self >= 1982)) ? self : unknown];

model im:Age of agriculture:Planted ecology:Forest earth:Region named planted_forest_age
	observing
		Year of agriculture:Planted ecology:Forest earth:Region named plantation_year
	set to [
		def forest_age= scale.time.start.year - plantation_year
		def ret = (forest_age >= 0 ? forest_age : null)
		return ret
	];
	
model local:alessio.bulckaen:im.data.global:im-data-global-agriculture.global_forest_management_100m_2015_v3_2
	as presence of nca.landuse.ipcc:PlantedForest earth:Region named planted_forest_presence
	set to [((self == 31) || (self == 32) || (self == 40)) ? true : false];

model change in (im:Age of agriculture:Planted ecology:Forest earth:Region)
	observing
		im:Age of agriculture:Planted ecology:Forest earth:Region named planted_forest_age,
//		add GFW_forest_presence,
		presence of ecology:Forest earth:Region named forest_presence
	set to [forest_presence ? planted_forest_age + 1 : unknown];
/* DATA PREPROCESSING - PLANTATION FORESTS */

/* MODELLING - PLANTATIONS OLD FORESTS  */
model presence of im:Likely nca.landuse.ipcc:OldPlantedForest earth:Region named estimated_old_planted_forest_presence
	observing
		im:Age of agriculture:Planted ecology:Forest earth:Region named planted_forest_age,
	    type of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of nca.landuse.ipcc:PlantedForest earth:Region named planted_forest_presence,	
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		Year of im:Removed ecology:Forest earth:Region named year_of_deforestation
	set to [
	    (((planted_forest_age > 20) || (tropical_forest_type is ecology:Tropical nca.landuse.ipcc:OldPlantedForest) || planted_forest_presence) 
	    	&& ((forest_height_2000 >= 5) && (forest_height_2020 >= 5)) 
	    	&& (year_of_deforestation > 2020)
	    ) ? true : false
	];

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 3) Young Plantation Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
/* MODELLING - PLANTATIONS YOUNG FORESTS  */
model presence of im:Likely nca.landuse.ipcc:YoungPlantedForest earth:Region named estimated_young_forest_presence
	observing 
		im:Age of agriculture:Planted ecology:Forest earth:Region named planted_forest_age,
	    type of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of nca.landuse.ipcc:PlantedForest earth:Region named planted_forest_presence,	
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		Year of im:Removed ecology:Forest earth:Region named year_of_deforestation
	set to [
	    (((planted_forest_age <= 20) || (tropical_forest_type is ecology:Tropical nca.landuse.ipcc:YoungPlantedForest) || planted_forest_presence) 
	    	&& ((forest_height_2000 < 5) || (year_of_deforestation <= 2020))
	    ) ? true : false
	];	

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 4) Young Secondary Forest. -------------------------------------------------------------------------------------------------------------------------------
 */	
// Boreal forest stand ages 
model local:rubencc:im.data.global:im-data-global-ecology.boreal_canopy_cover_stand_age_30m_2020
	as im:Age of ecology:Boreal ecology:Forest earth:Region;

/* MODELLING - SECONDARY YOUNG FORESTS  */
model presence of im:Likely nca.landuse.ipcc:YoungSecondaryForest earth:Region named estimated_young_secondary_forest_presence
	observing 
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		type of ecology:Tropical ecology:Forest named tropical_forest_type,
		im:Age of ecology:Boreal ecology:Forest earth:Region named boreal_forest_age
	set to [		        
		(((forest_height_2000 < 5) && (forest_height_2020 >= 5)) 
			|| ((forest_height_2000 >= 5) && (forest_height_2020 >= 5) && (year_of_deforestation <= 2020)) 
			|| (tropical_forest_type is ecology:Tropical nca.landuse.ipcc:YoungSecondaryForest) 
			|| (boreal_forest_age <= 20)
		) ? true : false
	];	
		
/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */
 

/* MODELLING SECONDARY OLD FORESTS  */

/// Anything which isnt identified as other forest types 


/*
 * # 5) Final Forest Type Estimation. -------------------------------------------------------------------------------------------------------------------------------
 */
/* FOREST TYPES  */

// TODO: Need to confirm with Alessio about the combinations below.
define FOREST_TYPE_TABLE as {{	 
     primary_forest | old_planted_forest	| young_planted_forest	|  young_secondary_forest 	| 	  forest_type
  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
	  	  true		|	  false				|	  false				|	    false				| nca.landuse.ipcc:PrimaryForest		,
		  false		|	  true				|		#				|		  #					| nca.landuse.ipcc:OldPlantedForest		,
		  false		|	  false				|	  true				|		  #					| nca.landuse.ipcc:YoungPlantedForest	,
		  false		|     false				|  	  false				|	    true				| nca.landuse.ipcc:YoungSecondaryForest	,
		  false		|     false				|  	  false				|	  	false				| nca.landuse.ipcc:OldSecondaryForest	
}};

		
model nca.landuse.ipcc:ForestType
	observing
		presence of im:Likely nca.landuse.ipcc:PrimaryForest earth:Region named estimated_primary_forest_presence,
		presence of im:Likely nca.landuse.ipcc:OldPlantedForest earth:Region named estimated_old_planted_forest_presence,
		presence of im:Likely nca.landuse.ipcc:YoungPlantedForest earth:Region named estimated_young_planted_forest_presence,
		presence of im:Likely nca.landuse.ipcc:YoungSecondaryForest earth:Region named estimated_young_secondary_forest_presence
	lookup (estimated_primary_forest_presence, estimated_old_planted_forest_presence, estimated_young_planted_forest_presence, estimated_young_secondary_forest_presence, ?) 
			into FOREST_TYPE_TABLE;			

private model local:rubencc:im.data.global:im-data-global-landcover.copernicus_landcover_10m_2020 
	as landcover:LandCoverType named copernicus_landcover_2020 
	classified into // according to im:copernicus-gdlc-encoding;// im:copernicus-encoding;
		landcover:Forest if 10,
		landcover:Shrubland if 20,
		landcover:Grassland if 30,
		landcover:AgriculturalVegetation if 40,
		landcover:ArtificialSurface if 50,
		landcover:SparseVegetation if 60,
		landcover:GlacierPerpetualSnow if 70,
		landcover:WaterBody if 80,
		landcover:AquaticVegetationOverWaterBody if 90, //Should be HerbaceusWetland, so including both InlandMarsh&SaltMarsh, but that's inconsistent with our current structure
		landcover:Mangrove if 95,
		landcover:LichenMoss if 100;

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */
 
 
 
 
 							
//---------------------------------------------------------------------------------------------------------------------------------------//			
/*
 * COMPARISON AGAINST OTHER DATASET
*/
//---------------------------------------------------------------------------------------------------------------------------------------//			

abstract identity MapProvider
	has children
		CanadaForestService,
		ChineseAerospaceResearchInstitute,
		Copernicus,
		EuropeanSpaceAgency,
		NASAAmericanSpaceAgency,
		ARIESModelled;

observe earth:Region named test_primary_forest_north_colombia_forest_jrc
	over space(shape='EPSG:4326 POLYGON ((-74.43535216382925 10.422696050854867, -75.09006865552847 10.422696050854867, -75.09006865552847 10.741280420857393, -74.43535216382925 10.741280420857393, -74.43535216382925 10.422696050854867))',
			   grid="300 m"),
			time(year=2020);
		
////TODO:Removed ARIESModelled after comparison script is run
//model ARIESModelled nca.landuse.ipcc:ForestType named forest_type_modelled
//	observing
//			im:Possible presence of nca.landuse.ipcc:PrimaryForest earth:Region named primary,
//			im:Possible presence of nca.landuse.ipcc:OldPlantedForest earth:Region named old_planted,
//			im:Possible presence of nca.landuse.ipcc:YoungPlantedForest earth:Region named young_planted,
//			im:Possible presence of nca.landuse.ipcc:YoungSecondaryForest earth:Region named young_secondary
//	lookup (primary, old_planted, young_planted, young_secondary,*,?) 
//			into FOREST_TYPE_TABLE;	


define FOREST_TYPE_COMPARISON_TABLE as {{ 
        forest_type_modelled 		  |          forest_type_nasa          		| consistency
-----------------------------------------------------------------------------------------------------------------------------------
 nca.landuse.ipcc:PrimaryForest       | nca.landuse.ipcc:PrimaryForest          | true   	, 
 nca.landuse.ipcc:YoungSecondaryForest| nca.landuse.ipcc:YoungSecondaryForest 	| true   	, 
 nca.landuse.ipcc:OldSecondaryForest  | nca.landuse.ipcc:OldSecondaryForest     | true   	,
 			    #					  | nca.landuse.ipcc:PrimaryForest			| false		,
 				#					  | nca.landuse.ipcc:YoungSecondaryForest	| false		,
 				#					  | nca.landuse.ipcc:OldSecondaryForest		| false		
}};	



define FOREST_TYPE_LANDCOVER_TABLE as {{	 
     primary    | old_planted	| young_planted	|  young_secondary 	| old_secondary | 	  landcover		| 		     forest_type
  -----------------------------------------------------------------------------------------------------------------------------------------------
  	  true		|	  false		|	  false		|	    false		| 	  	#		| landcover:Forest  | nca.landuse.ipcc:PrimaryForest		,
	  false		|	  true		|		#		|		  #			|     	#		|	  	 #			| nca.landuse.ipcc:OldPlantedForest		,
	  false		|	  false		|	  true		|		  #			| 	 	#		|	  	 #			| nca.landuse.ipcc:YoungPlantedForest	,
	  false		|     false		|  	  false		|	    true		| 	  	#		|	  	 #			| nca.landuse.ipcc:YoungSecondaryForest	,
	  false		|     false		|  	  false		|	  	false		| 	  	#		| landcover:Forest  | nca.landuse.ipcc:OldSecondaryForest	
}};

model presence of landcover:Forest earth:Region named landcover_forest_area
	observing
		landcover:LandCoverType named landcover
	set to [landcover == landcover:Forest];
	 
model Copernicus nca.landuse.ipcc:ForestType named forest_type_with_landcover_mask
	observing
			im:Possible presence of nca.landuse.ipcc:PrimaryForest earth:Region named primary,
			im:Possible presence of nca.landuse.ipcc:OldPlantedForest earth:Region named old_planted,
			im:Possible presence of nca.landuse.ipcc:YoungPlantedForest earth:Region named young_planted,
			im:Possible presence of nca.landuse.ipcc:YoungSecondaryForest earth:Region named young_secondary,
			landcover:LandCoverType named landcover
	lookup (primary, old_planted, young_planted, young_secondary,*,landcover, ?) 
			into FOREST_TYPE_LANDCOVER_TABLE;
			
model local:alessio.bulckaen:im.data.global:im-data-global-ecology.global_nasa_ornl_daac_forest_classification_epsg4326_30m_2020
	as NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType named nasa_forest_type 
	classified into
		nca.landuse.ipcc:PrimaryForest if 1,	
	 	nca.landuse.ipcc:YoungSecondaryForest if 2,
	 	nca.landuse.ipcc:OldSecondaryForest if 3;

@colormap(values = {
true:  (94 50 50)
false: (56 93 56) // (22 92 22)
})
model presence of (earth:Region with ARIESModelled nca.landuse.ipcc:ForestType) named matching_forest_type 
	observing
		ARIESModelled nca.landuse.ipcc:ForestType named forest_type_modelled,  
		NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType	named forest_type_nasa                                                                                                   
	lookup (forest_type_modelled,  forest_type_nasa , ?) 
			into FOREST_TYPE_COMPARISON_TABLE; 

@colormap(values = {
true:  (94 50 50)
false: (56 93 56) // (22 92 22)
})
model presence of (earth:Region with Copernicus nca.landuse.ipcc:ForestType) named matching_forest_type_with_forest_mask 
	observing
		Copernicus nca.landuse.ipcc:ForestType        		named forest_type_modelled_with_forest_mask,  
		NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType	named forest_type_nasa                                                                                                   
	lookup (forest_type_modelled_with_forest_mask,  forest_type_nasa , ?) 
			into FOREST_TYPE_COMPARISON_TABLE; 

define table forest_type_result_comparison_by_forest_type_modelled_vs_nasa as {
	title: "Comparison of the forest type result between model & NASA dataset - semantics"
	label: "Areas of difference between model & NASA dataset by Forest Types"
	target: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType
	columns:({ title: "{classifier}", filter: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType}), 	
	rows:   ({ title: "Consistency in (km²) between  model & NASA dataset ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with ARIESModelled nca.landuse.ipcc:ForestType) }
	         { title: "Total area (km²) according to NASA dataset", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result map from the model & NASA dataset (%)", summarize: [(r1 / (r1 + r2))*100], style: bold })};

define table forest_type_result_comparison_by_forest_type_modelled_with_forest_mask_vs_nasa as {
	title: "Comparison of the forest type result between model with forest mask & NASA dataset - semantics"
	label: "Areas of difference between model & NASA dataset by Forest Types"
	target: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType
	columns:({ title: "{classifier}", filter: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType}), 	
	rows:   ({ title: "Consistency in (km²) between  model with forest mask & NASA dataset ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with Copernicus nca.landuse.ipcc:ForestType) }
	         { title: "Total area (km²) according to NASA dataset", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result map from the model with forest mask & NASA dataset (%)", summarize: [(r1 / (r1 + r2))*100], style: bold })};

define table forest_extent_result_by_forest_type_modelled as {
	title: "Extent of the forest type result model"
	label: "Areas of the model by Forest Types"
	target: aries.global.carbon.forest_type.ipcc:Copernicus nca.landuse.ipcc:ForestType	
	columns:({ title: "Modelled - {classifier}", target: im:Area in km^2, filter: aries.global.carbon.forest_type.ipcc:Copernicus nca.landuse.ipcc:ForestType }
			 { title: "Total", summarize: sum, style: bold }),
	rows:   ({ title: "Area {start} (km²)" })};

define table forest_extent_result_by_forest_type_modelled_with_forest_mask as {
	title: "Extent of the forest type result model with forest mask"
	label: "Areas of the model by Forest Types with forest mask"
	target: nca.landuse.ipcc:ForestType	
	columns:({ title: "Modelled - {classifier}", target: im:Area in km^2, filter: nca.landuse.ipcc:ForestType }
			 { title: "Total", summarize: sum, style: bold }),
	rows:   ({ title: "Area {start} (km²)" })};
		
define table forest_extent_result_by_forest_type_nasa as {
	title: "Extent of the forest type result NASA dataset"
	label: "Areas of the NASA dataset by Forest Types"
	target: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType	
	columns:({ title: "NASA - {classifier}", target: im:Area in km^2, filter: aries.global.carbon.forest_type.ipcc:NASAAmericanSpaceAgency nca.landuse.ipcc:ForestType }
			 { title: "Total", summarize: sum, style: bold }),
	rows:   ({ title: "Area {start} (km²)" })};

	
	
	
