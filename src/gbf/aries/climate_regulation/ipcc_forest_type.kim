project private namespace gbf.aries.climate_regulation.ipcc_forest_type
	using 
		nca.landuse.ipcc,
		gbf.aries.climate_regulation;
		
quantity Integrity
	describes im:Wholeness physical:Status;
	
quantity Year
	describes value of im:Year;

/*
 * # A) Universal inputs. -------------------------------------------------------------------------------------------------------------------------------
 */		
model 'local:rubencc:im.data.global:im-data-global-conservation.global_nasa_forest_height_30m_2000'
	as im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000;
	
model 'local:rubencc:im.data.global:im-data-global-conservation.global_nasa_forest_height_30m_2020'
	as im:Height of ecology:Forest earth:Region in m named forest_height_2020;


model local:rubencc:im.data.global:im-data-global-conservation.global_tropical_moist_forest_transition_subtyp_30m_v1_1982_2024	 
//	as type of ecology:Tropical ecology:Forest named tropical_forest_type
//	classified into
//		ecology:Tropical nca.landuse.ipcc:PrimaryForest if 10,
//		ecology:Tropical nca.landuse.ipcc:OldSecondaryForest if 31,
// 		ecology:Tropical nca.landuse.ipcc:YoungSecondaryForest if in (32, 33, 92, 93, 94),		
// 		ecology:Tropical nca.landuse.ipcc:OldPlantedForest if 81,
// 		ecology:Tropical nca.landuse.ipcc:YoungPlantedForest if in (82, 83, 84, 85, 86)
 	as value of ecology:Tropical ecology:Forest named tropical_forest_type
 	over space(shape='EPSG:4326 POLYGON ((-110.00014384489000463 -40.10780114231157256, 179.99999999999997158 -40.10780114231157256, 179.99999999999997158 30.0947298278733264, -110.00014384489000463 30.0947298278733264, -110.00014384489000463 -40.10780114231157256))');
	
@reliability(80)
model value of ecology:Tropical ecology:Forest named tropical_forest_type
	set to [0];
//model type of ecology:Tropical ecology:Forest named tropical_forest_type
//	set to [nca.landuse.ipcc:OtherLand];
 		
 //// FOREST LOSS (HANSEN GFC DATASET)
model local:alessio.bulckaen:im.data.global:im-data-global-conservation.global_forest_watch_data_lossyear_2000_2022 
	as gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation
	set to [self + 2000];
 
 
/*
 * # 1) Primary Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
/* MODELLING - PRIMARY FORESTS  */

model local:rubencc:im.data.global:im-data-global-conservation.global_intact_forest_landscapes_2000
	as presence of im:Reference conservation:Intact ecology:Forest earth:Region named intact_forest_presence_2000
	set to [self == 1 ? true : false];

model 'local:megan.critchley:im.data.global:im-data-global-ecology.global_forest_landscape_integrity_index_epsg4326_300m_2019'
	as gbf.aries.climate_regulation.ipcc_forest_type:Integrity of ecology:Forest earth:Region named forest_integrity
	set to [self * 0.001];
		 
	  	
model local:alessio.bulckaen:im.data.global:im-data-global-ecology.global_primary_humid_tropical_forests_epsg4326_30m_2001
	as presence of ecology:Tropical nca.landuse.ipcc:PrimaryForest earth:Region named tropical_humid_primary_forest_presence
	set to [self == 1 ? true : false] 	// binary result: 1 or 0
	over space(shape='EPSG:4326 POLYGON ((-161 -36, 180 -36, 180 33, -161 33, -161 -36))');

@reliability(80)
model presence of ecology:Tropical nca.landuse.ipcc:PrimaryForest earth:Region named tropical_humid_primary_forest_presence
	set to [false];

	

model local:rubencc:im.data.global:im-data-global-ecology.europe_primary_forests_100m_4326_2018
	as presence of nca.landuse.ipcc:PrimaryForest geography:European earth:Region named europe_primary_forest_presence
	set to [self >= 0 ? true : false]
	over space(shape='EPSG:4326 POLYGON ((-17.30784057913082208 28.10559029424747024, 62.39338637380548391 28.10559029424747024, 62.39338637380548391 75.19797243364514827, -17.30784057913082208 75.19797243364514827, -17.30784057913082208 28.10559029424747024))');
	
@reliability(80)
model presence of nca.landuse.ipcc:PrimaryForest geography:European earth:Region named europe_primary_forest_presence
	set to [false];

 
model presence of im:Likely nca.landuse.ipcc:PrimaryForest earth:Region named estimated_primary_forest_presence
	observing			
		gbf.aries.climate_regulation.ipcc_forest_type:Integrity of ecology:Forest earth:Region named forest_integrity,
		presence of im:Reference conservation:Intact ecology:Forest earth:Region named intact_forest_presence_2000,
		value of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of ecology:Tropical nca.landuse.ipcc:PrimaryForest earth:Region named tropical_humid_primary_forest_presence,
		presence of nca.landuse.ipcc:PrimaryForest geography:European earth:Region named europe_primary_forest_presence,
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		type of nca.landuse.ipcc:LandUse named landuse			
	set to [
		((landuse is nca.landuse.ipcc:ForestLand) &&
			((!nodata(forest_integrity) && (forest_integrity >= 9.8)) || intact_forest_presence_2000 || (tropical_forest_type == 10) || tropical_humid_primary_forest_presence || europe_primary_forest_presence) 
			&& (!nodata(forest_height_2000) && !nodata(forest_height_2020) && (forest_height_2000 >= 5) && (forest_height_2020 >= 5)) 
			&& (nodata(year_of_deforestation) || (year_of_deforestation > 2020))
		) ? true : false
	];

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 2) Old Plantation Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
model 'local:alessio.bulckaen:im.data.global:im-data-global-conservation.global_treeplantationyears_forestry_epsg4326_30m_2020_mosaic'
	as gbf.aries.climate_regulation.ipcc_forest_type:Year of agriculture:Planted ecology:Forest earth:Region named plantation_year
	set to [((self != 32767) && (self >= 1982)) ? self : unknown];

model im:Age of agriculture:Planted ecology:Forest earth:Region in year named planted_forest_age
	observing
		gbf.aries.climate_regulation.ipcc_forest_type:Year of agriculture:Planted ecology:Forest earth:Region named plantation_year
	set to [
		def forest_age= scale.time.start.year - plantation_year
		def ret = (forest_age >= 0 ? forest_age : null)
		return ret
	];
	
model local:alessio.bulckaen:im.data.global:im-data-global-agriculture.global_forest_management_100m_2015_v3_2
	as presence of nca.landuse.ipcc:PlantedForest earth:Region named iiasa_planted_forest_presence
	set to [((self == 31) || (self == 32) || (self == 40)) ? true : false];  // code 53
/*
 * 40	Oil palm plantations
 * 32	Short rotation plantations for timber
 * 31	Planted forest
 */
	
	
/* MODELLING - PLANTATIONS OLD FORESTS  */
model presence of im:Likely nca.landuse.ipcc:OldPlantedForest earth:Region named estimated_old_planted_forest_presence
	observing
		im:Age of agriculture:Planted ecology:Forest earth:Region in year named planted_forest_age,
	    value of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of nca.landuse.ipcc:PlantedForest earth:Region named iiasa_planted_forest_presence,	
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		type of nca.landuse.ipcc:LandUse named landuse
	set to [
	    ((landuse is nca.landuse.ipcc:ForestLand) &&
	    	((!nodata(planted_forest_age) && (planted_forest_age > 20)) || (tropical_forest_type == 81) || iiasa_planted_forest_presence) 
	    	&& (!nodata(forest_height_2000) && !nodata(forest_height_2020) && (forest_height_2000 >= 5) && (forest_height_2020 >= 5)) 
	    	&& (nodata(year_of_deforestation) || (year_of_deforestation > 2020))
	    ) ? true : false
	];	
	

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 3) Young Plantation Forest. -------------------------------------------------------------------------------------------------------------------------------
 */
/* MODELLING - PLANTATIONS YOUNG FORESTS  */
model presence of im:Likely nca.landuse.ipcc:YoungPlantedForest earth:Region named estimated_young_planted_forest_presence
	observing 
		im:Age of agriculture:Planted ecology:Forest earth:Region in year named planted_forest_age,
	    value of ecology:Tropical ecology:Forest named tropical_forest_type,
		presence of nca.landuse.ipcc:PlantedForest earth:Region named iiasa_planted_forest_presence,	
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		type of nca.landuse.ipcc:LandUse named landuse
//Adjust underestimation of planted forest including planted forest as a whole, since those with planted_forest_age > 20 have been mapped as OldPlantedForest already
	set to [
	    ((landuse is nca.landuse.ipcc:ForestLand) &&
	    	((!nodata(planted_forest_age) && (planted_forest_age <= 20)) || ((tropical_forest_type == 82) || (tropical_forest_type == 83) || (tropical_forest_type == 84) || (tropical_forest_type == 85) || (tropical_forest_type == 86)) || iiasa_planted_forest_presence) 
	    	&& ((nodata(forest_height_2000) || (forest_height_2000 < 5)) || (year_of_deforestation <= 2020))
	    ) ? true : false
	];	

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 4) Young Secondary Forest. -------------------------------------------------------------------------------------------------------------------------------
 */	
// Boreal forest stand ages 
model local:rubencc:im.data.global:im-data-global-ecology.boreal_canopy_cover_stand_age_30m_2020
	as im:Age of ecology:Boreal ecology:Forest earth:Region in year named boreal_forest_age
	over space(shape='EPSG:4326 POLYGON ((-165 45, 180 45, 180 72.5, -165 72.5, -165 45))');
	
@reliability(80)
model im:Age of ecology:Boreal ecology:Forest earth:Region in year named boreal_forest_age
	set to [999];


/* MODELLING - SECONDARY YOUNG FORESTS  */
model presence of im:Likely nca.landuse.ipcc:YoungSecondaryForest earth:Region named estimated_young_secondary_forest_presence
	observing 
		im:Reference im:Height of ecology:Forest earth:Region in m named forest_height_2000,
		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		value of ecology:Tropical ecology:Forest named tropical_forest_type,
		im:Age of ecology:Boreal ecology:Forest earth:Region in year named boreal_forest_age,
		type of nca.landuse.ipcc:LandUse named landuse
	set to [		        
		((landuse is nca.landuse.ipcc:ForestLand) &&
			(((nodata(forest_height_2000) || (forest_height_2000 < 5)) && (!nodata(forest_height_2020) && (forest_height_2020 >= 5))) 
			|| (!nodata(forest_height_2000) && !nodata(forest_height_2020) && !nodata(year_of_deforestation) && (forest_height_2000 >= 5) && (forest_height_2020 >= 5) && (year_of_deforestation <= 2020)) 
			|| ((tropical_forest_type == 32) || (tropical_forest_type == 33) || (tropical_forest_type == 92) || (tropical_forest_type == 93) || (tropical_forest_type == 94)) 
			|| ((boreal_forest_age != 999) && (boreal_forest_age <= 20)))
		) ? true : false
	];	
		
/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */
 

/* MODELLING SECONDARY OLD FORESTS  */

/// Anything which isnt identified as other forest types 


/*
 * # 5) Final Forest Type Estimation. -------------------------------------------------------------------------------------------------------------------------------
 */
/* FOREST TYPES  */
model local:alessio.bulckaen:im.data.global:im-data-global-agriculture.global_forest_management_100m_2015_v3_2
	as presence of landcover:AgroforestryLand earth:Region named iiasa_agroforestry_presence
	set to [(self == 53) ? true : false];  // code 53: Agroforestry
	
model presence of nca.landuse.ipcc:PerennialCropland earth:Region named perennial_cropland_presence
	observing
		presence of landcover:AgroforestryLand earth:Region named iiasa_agroforestry_presence,
		landcover:LandCoverType named landcover
	set to [(iiasa_agroforestry_presence && (landcover is landcover:Forest)) ? true : false];
	
	define FOREST_TYPE_TABLE as {{	 
     primary_forest |	perennial_cropland	| old_planted_forest	| young_planted_forest	|  young_secondary_forest 	|forest_height_2020	|	landuse						| 	  forest_type
  -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  	 true		|		#				|	  	#				|	  	#				|	    	#				|		#			|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:PrimaryForest		,
		 #			|		true			|	  	#				|		#				|		  	#				|		#			|				#				| nca.landuse.ipcc:PerennialCropland	,	  	 
		 false		|		#				|	  true				|		#				|		  	#				|		#			|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:OldPlantedForest		,
		 false		|		#				|	  false				|	  true				|		  	#				|		#			|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:YoungPlantedForest	,
		 false		|		#				|	  false				|	  false				|	    	true			|		#			|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:YoungSecondaryForest	,
		 false		|		#				|	  false				|	  false				|	  		false			|		>= 5		|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:OldSecondaryForest	,
		 false		|		#				|	  false				|	  false				|	  		false			|		#			|	nca.landuse.ipcc:ForestLand	| nca.landuse.ipcc:OtherForest			,
		  #			|		#				|	  	#				|	  	#				|	  		#				|		#			|				#				| nca.landuse.ipcc:OtherLand			
}};

/*
 * The model to produce reference layer of forest type in 2020.
 */		
//model im:Reference nca.landuse.ipcc:ForestType named ipcc_forest_type_2020
//	observing
//		presence of im:Likely nca.landuse.ipcc:PrimaryForest earth:Region named estimated_primary_forest_presence,
//		presence of nca.landuse.ipcc:PerennialCropland earth:Region named perennial_cropland_presence,
//		presence of im:Likely nca.landuse.ipcc:OldPlantedForest earth:Region named estimated_old_planted_forest_presence,
//		presence of im:Likely nca.landuse.ipcc:YoungPlantedForest earth:Region named estimated_young_planted_forest_presence,
//		presence of im:Likely nca.landuse.ipcc:YoungSecondaryForest earth:Region named estimated_young_secondary_forest_presence,
//		im:Height of ecology:Forest earth:Region in m named forest_height_2020,
//		type of nca.landuse.ipcc:LandUse named landuse		
//	lookup (estimated_primary_forest_presence, perennial_cropland_presence, estimated_old_planted_forest_presence, estimated_young_planted_forest_presence, estimated_young_secondary_forest_presence, forest_height_2020, landuse, ?) 
//			into FOREST_TYPE_TABLE;		
			
/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */
 

/*
 * # 6) Model forest age in 2020. -----------------------------------------------------------------------------------------------------------------------------
 */
model im:Reference im:Age of ecology:Forest earth:Region in year named forest_age_2020  // forest age in year 2020
	observing
		im:Reference nca.landuse.ipcc:ForestType named ipcc_forest_type_2020,
		im:Age of agriculture:Planted ecology:Forest earth:Region in year named planted_forest_age,
		value of ecology:Tropical ecology:Forest named tropical_forest_type,
		im:Age of ecology:Boreal ecology:Forest earth:Region in year named boreal_forest_age
	set to [
		def ret = 0
		if ((ipcc_forest_type_2020 == nca.landuse.ipcc:PrimaryForest) || (ipcc_forest_type_2020 == nca.landuse.ipcc:OldPlantedForest) || (ipcc_forest_type_2020 == nca.landuse.ipcc:OldSecondaryForest)) {
			ret = 30
		} else if (ipcc_forest_type_2020 == nca.landuse.ipcc:YoungPlantedForest) {
			if (planted_forest_age != null) {
				ret = planted_forest_age
			} else if (tropical_forest_type == 82) {
				ret = 12
			} else if ((tropical_forest_type == 83) || (tropical_forest_type == 85)) {
				ret = 3
			} else if (tropical_forest_type == 84) {
				ret = 7
			} else if (tropical_forest_type == 86) {
				ret = 1
			} else {
				ret = 11
			}
		} else if (ipcc_forest_type_2020 == nca.landuse.ipcc:YoungSecondaryForest) {
			if (boreal_forest_age != 999) {
				ret = boreal_forest_age
			} else if (tropical_forest_type == 32) {
				ret = 10
			} else if ((tropical_forest_type == 33) || (tropical_forest_type == 94)) {
				ret = 3
			} else if (tropical_forest_type == 92) {
				ret = 5
			} else if (tropical_forest_type == 93) {
				ret = 15
			} else {
				ret = 11
			}			
		} else if (ipcc_forest_type_2020 == nca.landuse.ipcc:OtherForest) {
			ret = 3
		}
		return ret
	];

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 7) Model dynamic forest age. -----------------------------------------------------------------------------------------------------------------------------
 */
model im:Age of ecology:Forest earth:Region in year named forest_age
	observing
		im:Reference im:Age of ecology:Forest earth:Region in year named forest_age_2020,
		landcover:LandCoverType named landcover,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation
	set to [
		def ret = forest_age_2020
		if (scale.time.start.year != 2020) {
			if (forest_age_2020 == 0) {
				if (landcover == landcover:Forest) {
					ret = 3
				} else {
					ret = 0
				}
			} else {
				def accu_year = scale.time.start.year - 2020
				if (nodata(year_of_deforestation) || (year_of_deforestation < 2020) || (year_of_deforestation > scale.time.start.year)) {
					ret = forest_age_2020 + accu_year
				} else {
					if (landcover == landcover:Forest) {
						ret = scale.time.start.year - year_of_deforestation
					} else {
						ret = 0
					}
				}
			}		
		}
		return ret
	];

/* ---------------------------------------------------------------------------------------------------------------------------------------------------- */



/*
 * # 8) Model dynamic forest type. -----------------------------------------------------------------------------------------------------------------------------
 */
model local:liberentaizp:im.data.global:global_forest_type_2020_epsg_4326
	as im:Reference nca.landuse.ipcc:ForestType;

model nca.landuse.ipcc:ForestType named forest_type
	observing
		im:Reference nca.landuse.ipcc:ForestType named ipcc_forest_type_2020,
		gbf.aries.climate_regulation.ipcc_forest_type:Year of im:Removed ecology:Forest earth:Region named year_of_deforestation,
		im:Age of ecology:Forest earth:Region in year named forest_age,
		landcover:LandCoverType named landcover
	set to [
		def ret = ipcc_forest_type_2020
		if (((ipcc_forest_type_2020 == nca.landuse.ipcc:PrimaryForest) || (ipcc_forest_type_2020 == nca.landuse.ipcc:OldPlantedForest)) && (nodata(year_of_deforestation) || (year_of_deforestation < 2020) || (year_of_deforestation > scale.time.start.year))) {
			ret = ipcc_forest_type_2020			
		} else if ((ipcc_forest_type_2020 == nca.landuse.ipcc:YoungPlantedForest) && (nodata(year_of_deforestation) || (year_of_deforestation < 2020) || (year_of_deforestation > scale.time.start.year))) {
			if (!nodata(forest_age) && (forest_age <= 20)) {
				ret = ipcc_forest_type_2020
			} else if (!nodata(forest_age) && (forest_age > 20)) {
				ret = nca.landuse.ipcc:OldPlantedForest
			}
		} else if ((ipcc_forest_type_2020 == nca.landuse.ipcc:YoungSecondaryForest) && (nodata(year_of_deforestation) || (year_of_deforestation < 2020) || (year_of_deforestation > scale.time.start.year))) {
			if (!nodata(forest_age) && (forest_age <= 20)) {
				ret = ipcc_forest_type_2020
			} else if (!nodata(forest_age) && (forest_age > 20)) {
				ret = nca.landuse.ipcc:OldSecondaryForest
			}
		} else if ((ipcc_forest_type_2020 == nca.landuse.ipcc:OldSecondaryForest) && (nodata(year_of_deforestation) || (year_of_deforestation < 2020) || (year_of_deforestation > scale.time.start.year))) {
			ret = ipcc_forest_type_2020
		} else if (ipcc_forest_type_2020 == nca.landuse.ipcc:PerennialCropland) {
			if (landcover == landcover:Forest) {
				ret = ipcc_forest_type_2020
			} else {
				ret = nca.landuse.ipcc:OtherLand
			}
		} else {
			if (landcover == landcover:Forest) {
				ret = nca.landuse.ipcc:OtherForest
			} else {
				ret = nca.landuse.ipcc:OtherLand
			}
		}
		return ret
	];


