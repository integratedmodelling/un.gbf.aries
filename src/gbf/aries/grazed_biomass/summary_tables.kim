project private namespace gbf.aries.grazed_biomass.summary_tables
using gbf.aries.grazed_biomass;


//TODO: Check the unit of the output, if possible generate results with extensive properties
define table grazing_biomass_supply_by_natural_ecosystem_typology_static as {
	title: "Potential supply of dry matter for grazing by natural ecosystem type (tonnes/ha)",
	label: "Potential supply of dry matter for grazing by natural ecosystem type (tonnes/ha)",
	target: gbf.aries.grazed_biomass.potential_natural_vegetation_supply_for_grazing
	columns:({ title:  "{classifier}", target: im:Potential im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity, filter: landcover:LandCoverType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Dry Matter {start} (tonnes)" })};

define table grazing_biomass_use_by_natural_ecosystem_typology_static as {
	title: "Potential use of dry matter for grazing by natural ecosystem type (tonnes/ha)",
	label: "Potential use of dry matter for grazing by natural ecosystem type (tonnes/ha)",
	target: gbf.aries.grazed_biomass.estimated_use_of_natural_grazed_biomass
	columns:({ title:  "{classifier}", target: ses:UseFlow im:Natural agriculture:Pasture ecology:Vegetation ecology:PrimaryProductivity in t, filter: landcover:LandCoverType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Dry Matter {start} (tonnes)" })};

