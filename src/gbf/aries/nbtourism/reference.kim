project private namespace gbf.aries.nbtourism.reference;


/*5. Allowing for use at non-country scale */ 

// take last version of 2020 results + 2022
model local:rubencc:un.seea.aries:im-data-global-conservation.global_gbfb1_nature_based_tourism_epsg4326_1km_2020_v1 as 
	  im:Reference behavior:Outdoor behavior.incubation:Inbound behavior.incubation:OvernightVisitor im:Numerosity;

model behavior:Outdoor behavior.incubation:Inbound behavior.incubation:OvernightVisitor im:Numerosity of earth:Region  
	observing 
		 im:Reference behavior:Outdoor behavior.incubation:Inbound behavior.incubation:OvernightVisitor im:Numerosity named region_overnight_visitors
	set to [region_overnight_visitors.sum];

