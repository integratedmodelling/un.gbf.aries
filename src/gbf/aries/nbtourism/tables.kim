@documented(recreation.tables.opportunity)
define RECREATION_OPPORTUNITY_TABLE as {{
	
	remoteness | recreation_potential | score |  description 
   ---------------------------------------------------------------------------------------
       <= 0.25 |	<0.65             |   1   | 'low provision, easily accessible',
   0.25 to 0.5 |	<0.65             |	  2   | 'low provision, accessible',
          >0.5 |	<0.66             |	  3   | 'low provision, not easily accessible',
       <= 0.25 |	0.65 to 0.85      |	  4   | 'medium provision, easily accessible',
   0.25 to 0.5 |	0.65 to 0.85      |	  5   | 'medium provision, accessible',
          >0.5 |	0.65 to 0.85      |	  6   | 'medium provision, not easily accessible',
       <= 0.25 |	>0.85             |	  7   | 'high provision, easily accessible',
   0.25 to 0.5 |    >0.85             |	  8   | 'high provision, accessible',
          >0.5 |    >0.85             |	  9   | 'high provision, not easily accessible'
}};