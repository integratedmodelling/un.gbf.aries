worldview im;

@test(
    name = "pilot_countries",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (""),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
//observe /* a:urn:to:use#objectid as */ earth:Region named pilot_countries
    // add any space and/or time extents: for example
    // over space(shape="EPSG:4326 POLYGON((33.796 -7.086, 35.946 -7.086, 35.946 -9.41, 33.796 -9.41, 33.796 -7.086))", grid="1 km")
//;

// add any models here

/*Test countries */

observe earth:Region named australia
	over space 
	(	urn ='local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un#GID=AUS',
	//urn = 'local:justus.muhando:im.data.global:im-data-global-geography_administrative_level_0_un_v1#GID=AUS1',	 
	//urn = 'local:rubencc:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_can_rus_1#CID=UGA', // UGA UGANDA GADM
                 grid= "1000 m",
                 projection= "EPSG:4326"
	),
//		 time(start=2020, end=2021, step = 1.year);  
         time (year = 2020);

observe earth:Region named uganda_gadm
	over space 
	(	urn = 'local:justus.muhando:im.data.global:im-data-global-geography_administrative_level_0_un_v1#GID=UGA',	 
	//urn = 'local:rubencc:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_can_rus_1#CID=UGA', // UGA UGANDA GADM
                 grid= "500 m",
                 projection= "EPSG:4326"
	),
		 time(start=2020, end=2023, step = 1.year);  
//         time (year = 2022);
         
observe earth:Region named albania
	over space 
(urn = 'local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un#GID=ALB',
                 grid= "1000 m",
                 projection= "EPSG:4326"
	),
		 time(start=2022, end=2023, step = 1.year);  

observe earth:Region named algeria
	over space 
(urn = 'local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un#GID=DZA',
                 grid= "2000 m",
                 projection= "EPSG:4326"
	),
		 time(start=2022, end=2023, step = 1.year);  
		 
observe earth:Region named colombia_continental_gadm
	over space(
			urn='local:rubencc:aries.heco:im-data-global-geography_gadm_lev0_colombia_4326_continental', 
			grid= '2000 m',
			projection='EPSG:4326',
			simplify = 0.01),
		 time(start=2020, end=2021, step = 1.year);  

 
