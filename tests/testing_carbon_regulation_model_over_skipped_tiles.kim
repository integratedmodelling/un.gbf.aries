worldview im;

@test(
    name = "testing_carbon_regulation_model_over_skipped_tiles",
    description  = "test to verify correct computation over skipped tiles. All model runs smoothly but were skipped in k.Actor script",
    // add to the list any concepts to be observed in the context below
    observations = (
    "gbf.aries.climate_regulation.vegetation_carbon_stock"
    ),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
observe earth:Region named testing_carbon_regulation_model_over_skipped_tiles
     over space(urn="klab:grid:tiles:square.1#select=50576",//,50337,50576,50357
     	grid="1 km"),
     	time (year=2020);

observe earth:Region named testing_carbon_regulation_model_over_skipped_tiles
     over space(urn="klab:grid:tiles:square.1#select=50337",//,50337,50576,50357
     	grid="1 km"),
     	time (year=2020);

observe earth:Region named testing_carbon_regulation_model_over_skipped_tiles
     over space(urn="klab:grid:tiles:square.1#select=50357",//,50337,50576,50357
     	grid="1 km"),
     	time (year=2020);