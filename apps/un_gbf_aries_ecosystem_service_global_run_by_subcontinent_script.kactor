script un.gbf.aries.ecosystem_service.global_run_by_subcontinent

action main:

global_terrestrial_tiles = 'local:rubencc:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_1d_tile_index'
australian_subregion_tiles = 'local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_1d_tile_index_australiaandnewzealand'
//spatial_boundaries = 'local:liberentaizp:im.data.global:northern_iberian_coastal_tiles_boolean_test'
spatial_boundaries = 'klab:grid:tiles:square.1#select=48057,47691'
//target_subcontinent = 'Northern Africa'
//'Northern Europe'
//'Southern Asia'
//'Southern Europe'
//'Northern Africa'
//'Polynesia'
//'Sub-Saharan Africa'
//'Latin America and the Caribbean'
//'Western Asia'
//'Australia and New Zealand'
//'Western Europe'
//'Eastern Europe'
//'Northern America'
//'South-eastern Asia'
//'Eastern Asia'
//'Melanesia'
//'Micronesia'
//'Central Asia'



output_folder_directory = "UN_GBF/Test_results_by_subcontinent"

set observables_urns (
	// before the dependencies
	{landcover:LandCoverType}
//	gbf.aries.climate_regulation.ipcc_forest_type.ipcc_forest_type_2020	
		)

resolution = 300.m
for year in (2020) (
	for tile in spatial_boundaries (
//		if [tile.sub_continent == 'Northern Africa'](
//		if [tile.name == '48057' || tile.name == '47691']( // klab:grid:tiles:square.1
//		if [tile.coastal == 'TRUE'](
		// set context for all the observations
		    context(tile,resolution,Time(year=year))
		    // loop over urns
		    for urn in observables_urns (
		    	// submit the observation
				submit(urn): (
					WAITING     -> ()
					STARTED     -> ()
					ABORTED     -> warning("Aborted")
					INTERRUPTED -> warning("Interrupted")
					empty -> (
						// popup on application
						alert("The computation did not produce results. Some needed resources may be offline, or the system may be overloaded.")
						// error with detail in k.LAB console
						error(["Empty observation: " + urn_name])
					)
					observation -> (
						set urn_name ""
						if [urn.toString().startsWith("[")] (
							set urn_name [urn.name]
						) else (
							set urn_name urn
						)
						if [observation.isEmpty()] (
							warning(["Observation " + urn_name + " is empty"])
						) else (
							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ resolution +"/" + urn_name + "_" + tile.tile_index + "_" + resolution + "_" + year + ".tiff"])
						
							info(["Exporting urn " + urn_name])
						)
					)
				)	
			)
		)
	)
//)


