script un.gbf.aries.reference_layer.nature_based_tourism

action main:


nature_based_tourism_spatial_boundaries = 
//"local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un"
"local:justus.muhando:im.data.global:im-data-global-geography_administrative_level_0_un_v1" //10 minutes before starting running

/*country layer working fast in scripts */
//nature_based_tourism_spatial_boundaries = "local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un"
/*use the above for rapid testing */

output_folder_directory = "UN_GBF/Nature_Based_Tourism/tests"

set map_urns (
     //gbf.aries.nbtourism.visitors_indicator_weight
     gbf.aries.nbtourism.realized_visitors //exports only this one 
     
)
 	
set table_urns (
	gbf.aries.nbtourism.visitors_static
)
 	
resolution = 1000.m
warning("Start script un.gbf.aries.reference_layer.nature_based_tourism")
for year in (2022) (
	for country in nature_based_tourism_spatial_boundaries (
		if [    country.gid == 'AND' || country.gid == 'BLZ' || country.gid == 'BTN' || country.gid == 'BIH' || country.gid == 'MMR' 
			 || country.gid == 'SWZ' || country.gid == 'KGZ' || country.gid == 'LIE' || country.gid == 'MNG' || country.gid == 'NPL'
			 || country.gid == 'MKD' ||  country.gid == 'SVN'	] 	
		(
			context(country,resolution,Time(year=year))
		    // loop over urns
		    
		    for urn in map_urns (
		    	// submit the observation
		    	set urn_name ""
				if [urn.toString().startsWith("[")] (
					set urn_name [urn.name]
				) else (
					set urn_name urn
				)
		    	info(["Submiting  " + urn_name])
				submit(urn): (
					WAITING     -> ()
					STARTED     -> ()
					ABORTED     -> warning("Aborted")
					INTERRUPTED -> warning("Interrupted")
					empty -> (
						error(["Empty observation: " + urn_name])
					)
					observation -> (
						if [observation.isEmpty()] (
							warning(["Observation " + urn_name + " is empty"])
						) else (
							observation.export([output_folder_directory +"/"+ year +"/maps/"+ urn_name + "_" + country.gid + "_" + year +".tiff"])
							info(["Exported urn " + urn_name])
							
						)
					)
				)
			  )
			 /*  for table_urn in table_urns(
				info(["Submiting table: "+table_urn])
				submit(table_urn): (
					WAITING     -> ()
					STARTED     -> ()
					ABORTED     -> warning("Aborted")
					INTERRUPTED -> warning("Interrupted")
					empty -> (
						error(["Empty table: " + table_urn])
					)
					table -> (
						pack(:tables, filename=[output_folder_directory +"/"+ year +"/tables/"+ table_urn + "_" + country.gid + "_" + year +".xlsx"])
						info(["Exported table " + table_urn])
					)
				)
			)*/
		)
	)
)    