script un.gbf.aries.secondary_observations

action main:

//observe earth:Region named test_semantic_primary_forest_north_colombia_forest
//over space(shape='EPSG:4326 POLYGON ((-72.81428012081768 9.319326461106442, -72.82096193020851 9.252373938939925, -72.84075058019336 9.187982341549372, -72.87288560405088 9.12862833708337, -72.91613207083574 9.07659598842821, -72.96882804308235 9.033888501069669, -73.02894844412948 9.0021506956828, -73.09418288068079 8.982605265279943, -73.16202442992352 8.976005342944887, -73.22986597916626 8.982605265279943, -73.29510041571758 9.0021506956828, -73.3552208167647 9.033888501069669, -73.40791678901131 9.07659598842821, -73.45116325579619 9.12862833708337, -73.48329827965371 9.187982341549372, -73.50308692963854 9.252373938939925, -73.50976873902937 9.319326461106442, -73.50308692963854 9.386266146864273, -73.48329827965371 9.45062118933511, -73.45116325579619 9.509920485717672, -73.40791678901131 9.561888302127599, -73.3552208167647 9.604531257607988, -73.29510041571758 9.63621435579769, -73.22986597916626 9.65572323216712, -73.16202442992352 9.66231031846057, -73.09418288068079 9.65572323216712, -73.02894844412948 9.63621435579769, -72.96882804308235 9.604531257607988, -72.91613207083574 9.561888302127599, -72.87288560405088 9.509920485717672, -72.84075058019336 9.45062118933511, -72.82096193020851 9.386266146864273, -72.81428012081768 9.319326461106442))',
//		   grid="300 m"),
//		time(start=2020, end=2022, step=1.year);

output_folder_directory = "UN_GBF"

set observables_urns (
//	{im:Possible presence of nca.landuse.ipcc:PrimaryForest earth:Region}
	gbf.aries.climate_regulation.ipcc_forest_type.primary_forest
//	{type of nca.landuse.ipcc:LandUse}
)
set secondary_urns (
	[gbf.aries.climate_regulation.ipcc_forest_type.forest_integrity]
	[{im:Height of ecology:Forest earth:Region in m}]
	[{presence of earth:Tropical conservation:Intact ecology:Forest earth:Region}]

//when not using "[", "]" got error: org.integratedmodelling.klab.components.runtime.observations.ObservationGroup.export([Ljava.lang.Object;)
//k.Actors: cannot find a 'export' method to invoke on object of class org.integratedmodelling.klab.components.runtime.observations.ObservationGroup

//when using "[", "]" got error:Exception thrown in k.Actors interpreter: Cannot invoke "Object.toString()" because "object" is null
//	[{im:Height of ecology:Forest earth:Region in m}]
//	[{presence of earth:Tropical conservation:Intact ecology:Forest earth:Region}]

//	{landcover:LandCoverType}
//	{type of ecology:EcoFloristicRegion}
	
)

spatial_boundaries = Space(shape='EPSG:4326 POLYGON ((-72.81428012081768 9.319326461106442, -72.82096193020851 9.252373938939925, -72.84075058019336 9.187982341549372, -72.87288560405088 9.12862833708337, -72.91613207083574 9.07659598842821, -72.96882804308235 9.033888501069669, -73.02894844412948 9.0021506956828, -73.09418288068079 8.982605265279943, -73.16202442992352 8.976005342944887, -73.22986597916626 8.982605265279943, -73.29510041571758 9.0021506956828, -73.3552208167647 9.033888501069669, -73.40791678901131 9.07659598842821, -73.45116325579619 9.12862833708337, -73.48329827965371 9.187982341549372, -73.50308692963854 9.252373938939925, -73.50976873902937 9.319326461106442, -73.50308692963854 9.386266146864273, -73.48329827965371 9.45062118933511, -73.45116325579619 9.509920485717672, -73.40791678901131 9.561888302127599, -73.3552208167647 9.604531257607988, -73.29510041571758 9.63621435579769, -73.22986597916626 9.65572323216712, -73.16202442992352 9.66231031846057, -73.09418288068079 9.65572323216712, -73.02894844412948 9.63621435579769, -72.96882804308235 9.604531257607988, -72.91613207083574 9.561888302127599, -72.87288560405088 9.509920485717672, -72.84075058019336 9.45062118933511, -72.82096193020851 9.386266146864273, -72.81428012081768 9.319326461106442))') 
 	
resolution = 300.m
for year in (2020) (
//	for country in nature_based_tourism_spatial_boundaries (
//		if [country.gid == 'SEN'] (
			for urn in observables_urns(
		    	context(spatial_boundaries,resolution,Time(year=year),urn): state -> (
//		    	context(country,resolution,Time(year=year),urn): state -> (
					set urn_name ""
					if [urn.toString().startsWith("[")] (
						set urn_name [urn.name]
					)
					else (
						set urn_name urn
					)	
					
					
					if [state.toString().contains("[nothing")] (
						warning(["Observation " + urn_name + " return nothing"])
					) else ( 
						state.export([output_folder_directory + "/" + "Test_secondary_observation_export" + "/" + urn_name +".tiff"])
//						state.export([output_folder_directory + "/" + "Test_secondary_observation_export" + "/" + urn_name + "_" + country.gid +".tiff"])
					)
					
				)
				for secondary_urn in secondary_urns(
					submit([secondary_urn]): (
						WAITING     -> ()
						STARTED     -> ()
						ABORTED     -> warning("Aborted")
						INTERRUPTED -> warning("Interrupted")
						empty -> (
							alert("The computation did not produce results. Some needed resources may be offline, or the system may be overloaded.")
						)
						observation -> (
							observation.export([output_folder_directory + "/" + "Test_secondary_observation_export" + "/" + secondary_urn.name + ".tiff"])
						)
					)
				)
			)
		)
//	)
//)

