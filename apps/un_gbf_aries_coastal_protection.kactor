script un.gbf.aries.coastal_protection

action main:
info("started k.Actor")

//coastal_protection_spatial_boundaries = 
//'local:rubencc:im.data.global:im-data-global-geography_global_osm_coastline_6km_buffer_grid_split_4326'
//klab_grid_tiles = 'local:rubencc:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_1d_tile_index_v2'
//#select=13426, 23264, 25951, 31633, 35252, 35946, 37021, 38754, 43862, 44084, 44229, 44230, 44950, 45924, 46281, 46399, 51098, 54199, 55281, 56160, 57240, 61359'

klab_square_tiles = 'klab:grid:tiles:square.1#select=
11993, 12033, 12355, 12940, 13099, 13431, 13573, 13788, 14147, 14507, 15011, 15234, 15338, 15467, 15479, 16552, 17274, 17396, 17606, 17608, 17633, 17997, 18119, 18120, 18328, 18355, 18718, 19922, 19923, 20096, 20098, 20115, 20155, 20729, 20832, 20839, 21009, 21090, 21370, 21451, 21535, 21602, 21812, 21894, 21896, 21949, 22255, 22894,
23013, 23254, 23532, 23627, 23733, 23898, 24093, 24166, 24452, 24524, 24695, 24809, 24812, 24813, 24814, 24845, 24846, 24877, 25202, 25206, 25207, 25222, 25240, 25416, 25539, 25544, 25561, 25566, 25599, 25702, 25777, 25778, 25886, 25920, 25922, 25926, 25957, 25958, 26029, 26138, 26220, 26225, 26250, 26263, 26280, 26281, 26287, 26306,
26499, 26507, 26511, 26598, 26602, 26610, 26611, 26641, 26680, 26747, 26781, 26944, 26948, 27003, 27036, 27318, 27348, 27914, 28024, 28038, 28043, 28390, 28404, 28482, 28584, 28585, 28743, 28757, 28762, 28764, 28841, 28945, 29031, 29105, 29124, 29125, 29129, 29132, 29134, 29200, 29326, 29353, 29466, 29467, 29481, 29486, 29487, 29488'
output_folder_directory = "UN_GBF/Coastal_Protection"



set observables_urns (
	// before the dependencies
	gbf.aries.coastal.protection.exposurevulnerability.combined_delta
//	gbf.aries.coastal.protection.exposurevulnerability.cp_demand
//	gbf.aries.coastal.protection.exposurevulnerability.cp_supply
//	gbf.aries.coastal.protection.exposurevulnerability.cp_total_new
		)

resolution = 100.m
for year in (2020) (
		for tile in klab_square_tiles (
		
//				info(["Calculating "+tile.tile_index_1d])
//				info(["Calculating "+tile.tile_index])
				info(["Calculating "+tile.name])
		
			// set context for all the observations
		    context(tile,resolution,Time(year=year))
		    // loop over urns
		    for urn in observables_urns (
		    	// submit the observation
				submit(urn): (
					WAITING     -> ()
					STARTED     -> ()
//					ABORTED     -> warning(["Aborted: "+tile.tile_index_1d])
//					INTERRUPTED -> warning(["Interrupted: "+tile.tile_index_1d])
//					ABORTED     -> warning(["Aborted: "+tile.tile_index])
//					INTERRUPTED -> warning(["Interrupted: "+tile.tile_index])
					ABORTED     -> warning(["Aborted: "+tile.name])
					INTERRUPTED -> warning(["Interrupted: "+tile.name])
					empty -> (
						// popup on application
						alert("The computation did not produce results. Some needed resources may be offline, or the system may be overloaded.")
						// error with detail in k.LAB console
//						error(["Empty observation: " + urn_name + ", tile: " + tile.tile_index_1d])
						error(["Empty observation: " + urn_name + ", tile: " + tile.tile_index])
						error(["Empty observation: " + urn_name + ", tile: " + tile.name])
			
					)
					observation -> (
						set urn_name ""
						if [urn.toString().startsWith("[")] (
							set urn_name [urn.name]
						) else (
							set urn_name urn
						)
						if [observation.isEmpty()] (
//							warning(["Observation " + urn_name + ", tile: " + tile.tile_index_1d + " is empty"])
//							warning(["Observation " + urn_name + ", tile: " + tile.tile_index + " is empty"])
							warning(["Observation " + urn_name + ", tile: " + tile.name + " is empty"])

						) else (
//							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ urn_name + "/" + "tile_index_1d_" +  tile.tile_index_1d + "_" + resolution + "_" + year + ".tiff"])						
//							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ urn_name + "/" + "tile_index_" +  tile.tile_index + "_" + resolution + "_" + year + ".tiff"])						
							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ urn_name + "/" + "tile_index_" +  tile.name + "_" + resolution + "_" + year + ".tiff"])						

//							info(["Exporting urn " + urn_name + ", tile: " + tile.tile_index_1d])
//							info(["Exporting urn " + urn_name + ", tile: " + tile.tile_index])							
							info(["Exporting urn " + urn_name + ", tile: " + tile.name])							

						)
					)
				)	
			)
		)
	)
