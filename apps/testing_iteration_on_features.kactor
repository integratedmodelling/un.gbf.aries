script un.gbf.aries.reference_layer.nature_based_tourism

action main:

nature_based_tourism_spatial_boundaries = "local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un"

//gid->local:rubencc:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_can_rus_1#cid
//local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_level_0_un

output_folder_directory = "UN_GBF/Nature_Based_Tourism"

set observables_urns (
	  gbf.aries.nbtourism.features.distance_to_mountain //{distance to earth:Mountain in m} //
     //{geography:Elevation in m}
)
 	
 	//add table_urns
 	
resolution = 10000.m
for year in (2020) (
	for country in nature_based_tourism_spatial_boundaries (
		if [country.gid == 'UGA'] //!= 'RUS' && ]  // country.gid == 'RUS'|| country.gid == 'CAN' || 
		 (
			for urn in observables_urns( //and in table_urns
		    	context(country,resolution,Time(year=year),urn): state -> (
					set urn_name ""
					if [urn.toString().startsWith("[")] (
						set urn_name [urn.name]
					)
					else (
						set urn_name urn
					)	
										
					if [state.toString().contains("[nothing")] (
						warning(["Observation " + urn_name + " return nothing"])
					) else ( 
						state.export([output_folder_directory + "/" + "Reference_layers" + "/" + urn_name + "_" + country.gid +".tiff"])
					//if ... state.export table.urn
					)
					
				)

			)
		)
	)
)

