script alessio_test_shapefile_vm

action main:

australian_subcontinent = 'local:alessio.bulckaen:im.data.global:im-data-global-geography_administrative_units_un_gadm_level0_1d_tile_index_australiaandnewzealand'

spatial_boundaries = australian_subcontinent //global_terrestrial_tiles

output_folder_directory = "UN_GBF/Test_results_by_subcontinent"

set observables_urns (
	// before the dependencies
	{landcover:LandCoverType}
//	gbf.aries.climate_regulation.ipcc_forest_type.ipcc_forest_type_2020	
		)


resolution = 300.m
for year in (2020) (
	set valid_ids (17969 18686)
	for tile in spatial_boundaries (
//if [tile.sub_continent == 'Northern Africa'](		
//		if [tile_id in valid_ids] ( // for klab grid tiles
		if [tile.tile_index in valid_ids] ( 
			info(["Calculating tile "+tile_id])
			// set context for all the observations
		    context(tile,resolution,Time(year=year))
		    // loop over urns
		    for urn in observables_urns (
		    	// submit the observation
				submit(urn): (
					WAITING     -> ()
					STARTED     -> ()
					ABORTED     -> warning("Aborted")
					INTERRUPTED -> warning("Interrupted")
					empty -> (
						// popup on application
						alert("The computation did not produce results. Some needed resources may be offline, or the system may be overloaded.")
						// error with detail in k.LAB console
						error(["Empty observation: " + urn_name])
					)
					observation -> (
						set urn_name ""
						if [urn.toString().startsWith("[")] (
							set urn_name [urn.name]
						) else (
							set urn_name urn
						)
						if [observation.isEmpty()] (
							warning(["Observation " + urn_name + " is empty"])
						) else (
//							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ urn_name + "_" + tile.name + "_" + resolution + "_" + year + ".tiff"])
							observation.export([output_folder_directory +"/"+ year +"/"+ "maps" +"/"+ urn_name + "_" + tile.tile_index + "_" + resolution + "_" + year + ".tiff"])						
							info(["Exporting urn " + urn_name])
						)
					)
				)	
			)
		) else (
			info(["Skipping tile" + tile_id])
		)
	)
	
)

